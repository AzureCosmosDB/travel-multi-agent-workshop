table 'TravelAssistant OptimizationPolicies'
	lineageTag: da14a438-0029-494f-b4c0-3e65ba35efcb

	measure 'Active Policies' = CALCULATE(COUNTROWS('TravelAssistant OptimizationPolicies'), 'TravelAssistant OptimizationPolicies'[status] = "active")
		formatString: 0
		lineageTag: ab879b63-cdef-4a56-ba55-2de44bf2c517

	measure 'Latest Policy Change' = DATE(1970,1,1) + MAX('TravelAssistant OptimizationPolicies'[_ts]) / 86400.0
		formatString: General Date
		lineageTag: 5fe2d237-f65d-4c1c-8379-98d3847d65aa

	measure 'Selected Apply Mode' = SELECTEDVALUE('TravelAssistant OptimizationPolicies'[apply_mode])

	measure 'Apply Scenario' =
			VAR _scenario = SELECTEDVALUE('TravelAssistant OptimizationPolicies'[scenario])
			VAR _mode = [Selected Apply Mode]
			RETURN IF(_scenario = "model-selection" || _mode IN {"policy", "auto"}, _scenario, BLANK())

	measure 'Policy Status Display Measure' =
			VAR _status = LOWER(MAX('TravelAssistant OptimizationPolicies'[status]))
			RETURN
			    SWITCH(
			        _status,
			        "active", "🟢 ACTIVE",
			        "proposed", "🟡 PROPOSED",
			        "reverted", "🟡 REVERTED",
			        "deployed", "🟢 DEPLOYED",
			        "dismissed", "⚪ DISMISSED",
			        "⚪ " & UPPER(_status)
			    )

	measure 'Policy Version Label' = "v" & FORMAT(MAX('TravelAssistant OptimizationPolicies'[version]), "0")

		annotation SummarizationSetBy = User

	column _rid
		dataType: string
		isNullable: false
		sourceProviderType: varchar(max)
		lineageTag: 5c046875-ac08-4936-84d7-f9c150812e7c
		summarizeBy: none
		sourceColumn: _rid

		annotation SummarizationSetBy = Automatic

	column _ts
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 66f79793-96d3-446f-bf3e-84fbb9be5a5a
		summarizeBy: sum
		sourceColumn: _ts

		annotation SummarizationSetBy = Automatic

	column 'Policy Updated' = ```
			
			VAR e    = 'TravelAssistant OptimizationPolicies'[updated_epoch]
			VAR days = INT ( e / 86400 )
			VAR sod  = e - days * 86400
			RETURN ( DATE(1970,1,1) + days ) + TIME ( INT ( sod / 3600 ), INT ( MOD ( sod, 3600 ) / 60 ), MOD ( sod, 60 ) )
			```
		formatString: General Date
		lineageTag: ccd7e3ee-fba0-4cbd-a7d8-5b3844f721da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

