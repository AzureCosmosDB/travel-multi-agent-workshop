table 'TravelAssistant OptimizationTurns'
	lineageTag: f3377b41-40ce-4cd0-a2d8-14033b79e362

	measure 'Total Turns' = COUNTROWS('TravelAssistant OptimizationTurns')
		formatString: 0
		lineageTag: 674f844b-faf0-4b78-89df-e9c5c7626ef3

	measure 'Total Tokens' = SUM('TravelAssistant OptimizationTurns'[total_tokens])
		formatString: #,0
		lineageTag: 3d9879b7-e17a-4ea5-bb00-1f3910022ce0

	measure 'Trivial Turns' = COALESCE(CALCULATE(COUNTROWS('TravelAssistant OptimizationTurns'), 'TravelAssistant OptimizationTurns'[complexity_tier] = "trivial"), 0)
		formatString: 0
		lineageTag: f142d02c-0202-489d-af8d-60cca93c3b60

	measure 'Trivial %' = DIVIDE(COALESCE([Trivial Turns], 0), [Total Turns], 0) * 100
		formatString: 0.0\%
		lineageTag: a39b6a87-dcb8-457e-90bf-1f71af97b4bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Est Cost USD' =
			SUMX(
			    'TravelAssistant OptimizationTurns',
			    VAR d = 'TravelAssistant OptimizationTurns'[model_deployment]
			    VAR pin = COALESCE(LOOKUPVALUE('TravelAssistant Configuration'[input_price], 'TravelAssistant Configuration'[model], d, 'TravelAssistant Configuration'[type], "model_pricing"), 0.40)
			    VAR pout = COALESCE(LOOKUPVALUE('TravelAssistant Configuration'[output_price], 'TravelAssistant Configuration'[model], d, 'TravelAssistant Configuration'[type], "model_pricing"), 1.60)
			    RETURN ('TravelAssistant OptimizationTurns'[input_tokens] * pin + 'TravelAssistant OptimizationTurns'[output_tokens] * pout) / 1000000
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2910c8b5-c6e2-4ede-bf6e-4dc515ecc651

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Confirmed Trips' = CALCULATE(COUNTROWS('TravelAssistant Trips'), 'TravelAssistant Trips'[status] = "confirmed" || 'TravelAssistant Trips'[status] = "completed")
		formatString: 0
		lineageTag: 8ab98d68-0950-44af-a3af-5cb5c4539388

	measure 'Cost per Outcome' = DIVIDE([Est Cost USD], [Confirmed Trips])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 419878af-e6f9-4182-9149-fd5b89d5ccaf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cumulative Turns' =
			
			CALCULATE(
			    [Total Turns],
			    FILTER(
			        ALL('TravelAssistant OptimizationTurns'[Turn Time]),
			        'TravelAssistant OptimizationTurns'[Turn Time] <= MAX('TravelAssistant OptimizationTurns'[Turn Time])
			    )
			)
		formatString: 0
		lineageTag: da01b899-95f2-4ecc-b366-8c463f961794

	measure 'Cached Tokens' = SUM('TravelAssistant OptimizationTurns'[cached_tokens])
		lineageTag: 68e34112-bee4-4f4f-b283-bdbc1f86e853

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cache Hit %' = DIVIDE([Cached Tokens], SUM('TravelAssistant OptimizationTurns'[input_tokens])) * 100
		formatString: 0.0\%
		lineageTag: edded031-f6a5-4589-8848-99c2bb141edc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Models Used' = DISTINCTCOUNT('TravelAssistant OptimizationTurns'[model_deployment])
		formatString: 0

	measure 'Model Legend Detail' =
			FORMAT([Total Turns], "#,0") & " · " &
			FORMAT(
			    DIVIDE(
			        [Total Turns],
			        CALCULATE([Total Turns], REMOVEFILTERS('TravelAssistant OptimizationTurns'[model_deployment]))
			    ),
			    "0.0%"
			)

	measure 'Percent Maximum' = 100
		formatString: 0.0\%

	measure 'Turns Card Detail' = FORMAT([Total Tokens], "#,0") & " tokens"

	measure 'Trivial Turns Detail' = FORMAT([Trivial Turns], "#,0") & " of " & FORMAT([Total Turns], "#,0") & " turns"

	column 'Tier Model Label' = 'TravelAssistant OptimizationTurns'[complexity_tier] & " · " & 'TravelAssistant OptimizationTurns'[model_deployment]
		dataType: string
		summarizeBy: none

		annotation SummarizationSetBy = User

