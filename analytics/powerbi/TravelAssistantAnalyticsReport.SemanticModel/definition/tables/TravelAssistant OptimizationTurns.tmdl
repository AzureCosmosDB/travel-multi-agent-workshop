	column timeStamp
		dataType: string
		sourceProviderType: varchar(max)
		lineageTag: 4fbd2923-086c-4396-82f6-0bc5ee5824b7
		summarizeBy: none
		sourceColumn: timeStamp

		annotation SummarizationSetBy = Automatic

	column 'Turn Time' = ```
			
			VAR e    = 'TravelAssistant OptimizationTurns'[turn_epoch]
			VAR days = INT ( e / 86400 )
			VAR sod  = e - days * 86400
			RETURN ( DATE(1970,1,1) + days ) + TIME ( INT ( sod / 3600 ), INT ( MOD ( sod, 3600 ) / 60 ), MOD ( sod, 60 ) )
			```
		formatString: General Date
		lineageTag: e45c375d-6880-4ee6-bb5a-d5288d8b9048
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Time

	column 'Turn Minute' = ```
			
			VAR e    = 'TravelAssistant OptimizationTurns'[turn_epoch]
			VAR days = INT ( e / 86400 )
			VAR sod  = e - days * 86400
			RETURN ( DATE(1970,1,1) + days ) + TIME ( INT ( sod / 3600 ), INT ( MOD ( sod, 3600 ) / 60 ), 0 )
			```
		formatString: General Date
		lineageTag: 79cfccbb-77f4-470a-9d29-62d4a8c013d5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

