# Azure Cosmos DB Configuration
COSMOSDB_ENDPOINT=
COSMOSDB_DATABASE_NAME=TravelAssistant
COSMOSDB_KEY=

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=
# Chat deployment used by the workshop agents.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Embedding deployment used by azure.cosmos.agent_memory and place vector search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=

# MCP Server Configuration
MCP_SERVER_BASE_URL=http://localhost:8080
MCP_AUTH_TOKEN=banking-server-dev-token-2024
MCP_AUTH_SECRET_KEY="banking-mcp-server-jwt-secret-for-local-development"
PORT=8080
USE_REMOTE_MCP_SERVER="true"

# Optional: GitHub OAuth (Production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LangSmith (Optional - for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-assistant

# azure.cosmos.agent_memory auto-summarization thresholds.
# SDK defaults are FACT=1, SUMMARY=10, USER_SUMMARY=20, DEDUP=5.
# Workshop overrides SUMMARY/USER_SUMMARY to 5 so attendees see
# summaries without chatting forever.
FACT_EXTRACTION_EVERY_N=1
THREAD_SUMMARY_EVERY_N=5
USER_SUMMARY_EVERY_N=5
DEDUP_EVERY_N=1
