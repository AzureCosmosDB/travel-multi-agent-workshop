{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "servicePrincipalId": {
      "value": "${AZURE_SERVICE_PRINCIPAL_ID=}"
    },
    "owner": {
      "value": "${OWNER_EMAIL}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=}"
    },
    "resourceGroupLocation": {
      "value": "${AZURE_RG_LOCATION=}"
    },
    "deployAnalytics": {
      "value": "${DEPLOY_ANALYTICS=true}"
    },
    "deployHostedApp": {
      "value": "${DEPLOY_HOSTED_APP=true}"
    },
    "deployGsi": {
      "value": "${DEPLOY_GSI=false}"
    }
  }
}
