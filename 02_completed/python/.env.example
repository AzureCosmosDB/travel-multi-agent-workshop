## Azure Cosmos DB Configuration
COSMOSDB_ENDPOINT=
COSMOSDB_DATABASE_NAME=TravelAssistant
COSMOSDB_KEY=

## Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=
# Chat deployment used by the workshop agents.
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
# Embedding deployment used by azure-cosmos-agent-memory and place vector search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=

## MCP Server Configuration
MCP_SERVER_BASE_URL=http://localhost:8080
MCP_AUTH_TOKEN=banking-server-dev-token-2024
MCP_AUTH_SECRET_KEY="banking-mcp-server-jwt-secret-for-local-development"
PORT=8080
USE_REMOTE_MCP_SERVER="true"

## Optional: GitHub OAuth (Production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

## LangSmith (Optional - for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-assistant

# Toolkit defaults are FACT=1, THREAD_SUMMARY=10, USER_SUMMARY=20, DEDUP=5.
# Workshop tightens these so attendees see the memory pipeline at work in a
# short demo session: facts and dedup fire every turn; both summaries fire
# every 5 turns.
FACT_EXTRACTION_EVERY_N=1
DEDUP_EVERY_N=1
THREAD_SUMMARY_EVERY_N=5
USER_SUMMARY_EVERY_N=5

## Model pricing (USD per 1M tokens) for the optimization analytics.
# Single source of truth: python/data/model_pricing.json (this env var overrides it at
# runtime; the app + the Fabric notebook both read it). Format: {"deployment": {"input": x,
# "output": y}}. Models are discovered from the data; any model without an entry falls back
# to a default price. Change a price here or in model_pricing.json — one edit flows to the
# app, the notebook, and (via the committed model_pricing.csv) the Power BI report.
MODEL_PRICING_JSON={"gpt-5.1":{"input":1.25,"output":10.0},"gpt-5-mini":{"input":0.25,"output":2.0},"gpt-5-nano":{"input":0.05,"output":0.4}}
